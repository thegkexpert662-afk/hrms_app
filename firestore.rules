rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userData() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function sameCompany(companyId) { return signedIn() && userData().companyId == companyId; }
    function isAdmin(companyId) { return sameCompany(companyId) && (userData().role in ['owner', 'admin', 'hr']); }
    function sameEmployee(employeeId) { return signedIn() && userData().employeeId == employeeId; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || userData().role == 'owner');
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.companyId == resource.data.companyId
        && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /companies/{companyId} {
      allow read: if sameCompany(companyId);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAdmin(companyId);
      allow delete: if userData().role == 'owner' && sameCompany(companyId);

      match /employees/{employeeId} {
        allow read: if sameCompany(companyId);
        allow create, update, delete: if isAdmin(companyId);
      }

      match /attendance/{recordId} {
        allow read: if isAdmin(companyId) || sameEmployee(resource.data.employeeId);
        allow create, update: if isAdmin(companyId) || (sameEmployee(request.resource.data.employeeId) && request.resource.data.employeeId == resource.data.employeeId);
        allow delete: if isAdmin(companyId);
      }

      match /leaves/{leaveId} {
        allow read: if isAdmin(companyId) || sameEmployee(resource.data.employeeId);
        allow create: if isAdmin(companyId) || sameEmployee(request.resource.data.employeeId);
        allow update: if isAdmin(companyId) || (sameEmployee(resource.data.employeeId) && request.resource.data.employeeId == resource.data.employeeId && request.resource.data.status == resource.data.status);
        allow delete: if isAdmin(companyId);
      }

      match /notifications/{notificationId} {
        allow read: if sameCompany(companyId);
        allow create, update, delete: if isAdmin(companyId);
      }

      match /settings/{settingId} {
        allow read: if sameCompany(companyId);
        allow write: if isAdmin(companyId);
      }

      match /officeLocations/{locationId} {
        allow read: if sameCompany(companyId);
        allow write: if isAdmin(companyId);
      }

      match /qrSessions/{sessionId} {
        allow read: if sameCompany(companyId);
        allow create, update, delete: if isAdmin(companyId);
      }
    }
  }
}
